{
  "name": "i-bond-rate-mcp",
  "version": "1.0.0",
  "description": "MCP server for the current Series I savings bond rate (5.51 percent for November 2026 to April 2027, fixed 1.40 percent), the rate an existing I bond earns by issue month, value estimates and rate history from TreasuryDirect.",
  "type": "module",
  "license": "MIT",
  "author": "theluckystrike",
  "mcpName": "io.github.theluckystrike/i-bond-rate-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/i-bond-rate-mcp"
  },
  "homepage": "https://www.mcpstamp.com/servers/",
  "bin": {
    "i-bond-rate-mcp": "dist/stdio.js"
  },
  "main": "dist/stdio.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "start": "node dist/stdio.js",
    "deploy": "npx wrangler@4 deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "i-bond",
    "i-bonds",
    "i-bond-rate",
    "savings-bonds",
    "series-i",
    "treasurydirect",
    "treasury",
    "inflation",
    "fixed-rate",
    "composite-rate"
  ]
}
